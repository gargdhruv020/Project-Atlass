# ==============================================================================
# Project Atlas - Environment Configuration Template
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false
REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_SIZE_BYTES=10000000

# Security & API Authentication
API_KEY=atlas-dev-key-2026
SECRET_KEY=atlas-insecure-secret-key-change-in-production

# MySQL Relational Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=project_atlas

# Vector Storage (ChromaDB Local Persistence Exclusively - No Cloud/Pinecone)
CHROMA_PERSIST_DIRECTORY=chroma_data
CHROMA_COLLECTION_NAME=market_reports

# Embedding Configuration (Hugging Face / Ollama)
# Options for EMBEDDING_PROVIDER: 'huggingface' (default local ONNX/API) or 'ollama'
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# LLM Generation Configuration
# Options for LLM_PROVIDER: 'ollama', 'openai', 'openai-compatible', 'mock'
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.0

# Retrieval-Augmented Generation (RAG) Settings
RAG_SIMILARITY_THRESHOLD=0.60
RAG_TOP_K=4

# Analyst Escalation Settings
ESCALATION_CONFIDENCE_THRESHOLD=0.70

# Document Ingestion Pipeline
DOCUMENTS_DIR=documents
