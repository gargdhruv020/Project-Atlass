# ==============================================================================
# Project Atlas &mdash; Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false
REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_SIZE_BYTES=10000000

# ------------------------------------------------------------------------------
# 2. Security & API Authentication
# ------------------------------------------------------------------------------
# Set a strong secret API key in production
API_KEY=atlas-dev-key-2026
SECRET_KEY=atlas-insecure-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 3. MySQL Database Configuration
# ------------------------------------------------------------------------------
# A. For Local Development Against Existing Local MySQL (e.g. database 'project-atlas'):
#    DB_HOST=127.0.0.1
#    DB_PORT=3306
#    DB_USER=root
#    DB_PASSWORD=your_local_mysql_password
#    DB_NAME=project-atlas
#    DB_READONLY_USER=atlas_readonly
#    DB_READONLY_PASSWORD=your_readonly_password
#
# B. For Isolated Docker Compose Review Deployment:
#    (When using 'docker-compose up', containers communicate via internal service 'mysql:3306')
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_root_password
DB_NAME=project_atlas
DB_READONLY_USER=atlas_readonly
DB_READONLY_PASSWORD=AtlasReadOnly2026!

# Host Port Mapping for Docker Compose MySQL (avoids port 3306 collision on host)
MYSQL_HOST_PORT=3307

# ------------------------------------------------------------------------------
# 4. CodeIgniter 3 PHP Portal Settings
# ------------------------------------------------------------------------------
PHP_PORT=8080
FASTAPI_BASE_URL=http://backend:8000

# ------------------------------------------------------------------------------
# 5. ChromaDB Vector Store (Local Persistence Exclusively)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=chroma_data
CHROMA_COLLECTION_NAME=market_reports

# ------------------------------------------------------------------------------
# 6. Embedding Provider Configuration
# ------------------------------------------------------------------------------
# Options: 'huggingface' (default MiniLM local model) or 'ollama'
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 7. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: 'mock' (default deterministic grounded fallback), 'ollama', 'openai'
LLM_PROVIDER=mock
LLM_MODEL=llama3.2
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 8. RAG & Agent Settings
# ------------------------------------------------------------------------------
RAG_SIMILARITY_THRESHOLD=0.60
RAG_TOP_K=4
ESCALATION_CONFIDENCE_THRESHOLD=0.70

# ------------------------------------------------------------------------------
# 9. Document Ingestion & Startup Behavior
# ------------------------------------------------------------------------------
DOCUMENTS_DIR=documents
AUTO_INGEST_ON_STARTUP=true
