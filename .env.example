# Database Configuration for Project Atlas (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=project_atlas

# Security & API Key
API_KEY=your_atlas_api_key_here

# Vector Storage (ChromaDB - Local Persistence Exclusively)
CHROMA_PERSIST_DIRECTORY=chroma_data
CHROMA_COLLECTION_NAME=market_reports

# Embedding Model (Local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# LLM Generation Model & API
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.0

# RAG Pipeline Settings
RAG_SIMILARITY_THRESHOLD=0.60
RAG_TOP_K=4


